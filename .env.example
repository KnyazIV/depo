# Скопируйте в .env.local и заполните. На Vercel те же переменные заводятся
# в Project Settings → Environment Variables.

# --- База данных ---------------------------------------------------------
# Neon через Vercel Marketplace добавляет обе переменные сам.
# Локально возьмите строки подключения в консоли Neon.

# Pooled connection (в хосте есть -pooler). По ней работает само приложение.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"

# Прямое подключение, без пулера. По нему идут миграции: DDL надёжнее гонять
# мимо PgBouncer. Если не задать, миграции возьмут DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Отдельная база для интеграционных тестов. Если не задана, тест на
# конкурентность помечается skipped, а не падает.
TEST_DATABASE_URL=""

# --- Telegram ------------------------------------------------------------
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=""

# Куда приходят заявки: id личного чата или группы (у групп id отрицательный).
# Узнать: напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ADMIN_CHAT_ID=""

# Кому разрешено нажимать «Подтвердить» и «Отклонить», через запятую.
TELEGRAM_ADMIN_IDS=""

# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# --- Секреты приложения --------------------------------------------------
# Защита /api/cron/expire. На Vercel Cron подставляется автоматически,
# если переменная заведена в проекте.
CRON_SECRET=""

# Пароль к /admin (логин — admin).
ADMIN_PASSWORD=""

# Соль для HMAC-хэша IP в rate limit. Сырые IP не храним.
IP_HASH_SALT=""

# --- Прочее --------------------------------------------------------------
# Публичный адрес сайта. На Vercel можно не задавать — подставится из VERCEL_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
